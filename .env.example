# Wajib — daftar gratis di https://gmgn.ai/ai
# Atau pakai: gmgn-cli config  →  gmgn-cli config --apply <key>
GMGN_API_KEY=

# Opsional — kirim kartu ke Telegram (dua-duanya harus diisi)
# Bot dibuat lewat @BotFather; chat id bisa dari @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsional — kirim kartu ke Discord
DISCORD_WEBHOOK_URL=

# Opsional — teruskan kandidat yang lolos ke bot LP (unipool).
# Isi dengan path file JSONL yang SAMA dengan LP_ALERT_INBOX di bot itu.
# Chain yang diteruskan: bsc, base, hyperevm, robinhood.
LP_ALERT_INBOX=
